#!/bin/bash
#
# グローバル post-checkout hook
#
# 目的: checkout後にindex(staging area)とHEADの整合性を検証する
# 背景: lazygit + neovimの競合により、checkout後にワーキングツリーとindexが
#        古いコミットの状態で固定される問題が発生したため、再発を即座に検知する
#
# 引数: $1=前のHEAD, $2=新しいHEAD, $3=ブランチチェックアウトフラグ(1=branch, 0=file)

PREV_HEAD="$1"
NEW_HEAD="$2"
CHECKOUT_TYPE="$3"

# ファイルチェックアウト（git checkout -- <file>）の場合はスキップ
if [ "$CHECKOUT_TYPE" = "0" ]; then
    # ローカルhookのチェーン実行へ
    LOCAL_HOOK="$(git rev-parse --git-dir)/hooks/$(basename "$0")"
    if [ -x "$LOCAL_HOOK" ]; then
        exec "$LOCAL_HOOK" "$@"
    fi
    exit 0
fi

# indexとHEADの整合性チェック
# git diff --cached --quiet HEAD は、indexとHEADに差分があると終了コード1を返す
if ! git diff --cached --quiet HEAD 2>/dev/null; then
    echo ""
    echo "⚠️  WARNING: post-checkout 整合性チェック"
    echo "    indexとHEADに不整合が検出されました。"
    echo "    ワーキングツリーまたはindexが古いコミットの状態になっている可能性があります。"
    echo ""
    echo "    確認コマンド:"
    echo "      git diff --cached --stat HEAD   # indexとHEADの差分を確認"
    echo "      git status                      # ワーキングツリーの状態を確認"
    echo ""
    echo "    復旧コマンド:"
    echo "      git read-tree HEAD              # indexをHEADに合わせる"
    echo "      git checkout HEAD -- .          # ワーキングツリーもHEADに合わせる"
    echo ""
fi

# ローカルhookのチェーン実行
# core.hooksPathを設定すると .git/hooks/ は無視されるため、
# 対応するローカルhookが存在する場合にここで実行する
LOCAL_HOOK="$(git rev-parse --git-dir)/hooks/$(basename "$0")"
if [ -x "$LOCAL_HOOK" ]; then
    exec "$LOCAL_HOOK" "$@"
fi
