{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "DISABLE_AUTOUPDATER": "1"
  },
  "permissions": {
    "allow": [
      "Bash(rg:*)",
      "Bash(git grep:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(cat:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue create:*)",
      "Read(./**)",
      "mcp__awslabs_aws-documentation",
      "mcp__aws-knowledge",
      "Bash(terraform fmt -check:*)",
      "Bash(pnpm biome check:*)",
      "Bash(pnpm -F * biome check:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm -F api-schema build:*)",
      "Bash(pnpm -F @aim-management/api-schema build)",
      "Bash(pnpm test:*)",
      "Bash(pnpm -F frontend test:*)",
      "Bash(pnpm -F backend test:*)",
      "Bash(pnpm -F api-schema test:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm -F frontend typecheck:*)",
      "Bash(pnpm -F backend typecheck:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm run lint:*)",
      "Bash(pnpm run build:*)",
      "Bash(pnpm run test:*)",
      "Bash(pnpm run typecheck:*)",
      "Bash(pnpm run validate:*)",
      "Bash(pnpm validate:*)",
      "Bash(pnpm ls:*)",
      "Bash(pnpm view:*)",
      "Bash(pnpm why:*)",
      "Bash(pnpm list:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform fmt:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git ls-files:*)",
      "Reading Plan"
    ],
    "deny": [
      "NotebookEdit",
      "NotebookRead",
      "Bash(.*\\.ssh/.*:*)",
      "Bash(chgrp:*)",
      "Bash(chown:*)",
      "Bash(curl:*)",
      "Bash(dd:*)",
      "Bash(env:*)",
      "Bash(fdisk:*)",
      "Bash(git add:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git tag -d:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(rm -f:*)",
      "Bash(echo \"y\" | rm :*)",
      "Bash(kill -9:*)",
      "Bash(mkfs:*:*)",
      "Bash(poweroff:*)",
      "Bash(printenv:*)",
      "Bash(reboot:*)",
      "Bash(shutdown:*)",
      "Bash(su:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(terraform apply:*)",
      "Read(terraform destroy:*)",
      "Bash(drizzle push:*)",
      "Read(id_ed25519)",
      "Read(id_rsa)",
      "Read(~/.ssh/*)",
      "Read(~/.ssh/**)",
      "Write(.env*)",
      "Write(~/.ssh/*)",
      "Write(~/.ssh/**)"
    ],
    "defaultMode": "plan"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'jq -r \".cwd, .title, .message\" | { read -r cwd; read -r title; read -r message; name=$(basename \"$cwd\"); osascript -e \"display notification \\\"$message\\\" with title \\\"$title [$name]\\\" sound name \\\"Glass\\\"\"; }'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'jq -r \".cwd\" | xargs basename | { read -r name; osascript -e \"display notification \\\"作業が完了しました [$name]\\\" with title \\\"Claude Code\\\" sound name \\\"Glass\\\"\"; }'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.js"
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "lua-lsp@claude-plugins-official": true
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "~>''<~",
      "Thinking",
      "Processing",
      "Working"
    ]
  },
  "alwaysThinkingEnabled": true
}
