{
  "permissions": {
    "allow": [
      "Bash(rg:*)",
      "Bash(git grep:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(cat:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue create:*)",
      "Read(./**)",
      "mcp__awslabs_aws-documentation",
      "Bash(terraform fmt -check:*)",
      "Bash(sam validate:*)",
      "Bash(pnpm biome check:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm run lint:*)",
      "Bash(pnpm lint:fix:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm run build:*)",
      "Bash(pnpm run test:*)",
      "Bash(pnpm run typecheck:*)",
      "Bash(pnpm run validate:*)",
      "Bash(pnpm validate:*)" ,
      "Bash(pnpm * typecheck:*)",
      "Bash(pnpm * test:*)",
      "Bash(pnpm ls:*)",
      "Bash(pnpm why:*)",
      "Bash(pnpm list:*)"
    ],
    "deny": [
      "NotebookEdit",
      "NotebookRead",
      "Bash(.*\\.ssh/.*:*)",
      "Bash(chgrp:*)",
      "Bash(chown:*)",
      "Bash(curl:*)",
      "Bash(dd:*)",
      "Bash(env:*)",
      "Bash(fdisk:*)",
      "Bash(git add:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git tag -d:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(rm -f:*)",
      "Bash(rm -[rf].:*)",
      "Bash(kill -9:*)",
      "Bash(mkfs:*:*)",
      "Bash(poweroff:*)",
      "Bash(printenv:*)",
      "Bash(reboot:*)",
      "Bash(shutdown:*)",
      "Bash(su:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(id_ed25519)",
      "Read(id_rsa)",
      "Read(~/.ssh/*)",
      "Read(~/.ssh/**)",
      "Write(.env*)",
      "Write(~/.ssh/*)",
      "Write(~/.ssh/**)"
    ],
    "defaultMode": "plan"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'jq -r \".cwd, .title, .message\" | { read -r cwd; read -r title; read -r message; name=$(basename \"$cwd\"); osascript -e \"display notification \\\"$message\\\" with title \\\"$title [$name]\\\" sound name \\\"Glass\\\"\"; }'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'jq -r \".cwd\" | xargs basename | { read -r name; osascript -e \"display notification \\\"作業が完了しました [$name]\\\" with title \\\"Claude Code\\\" sound name \\\"Glass\\\"\"; }'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.js"
  },
  "alwaysThinkingEnabled": false
}
