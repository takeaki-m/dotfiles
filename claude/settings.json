{
  "permissions": {
    "allow": [
      "Bash(rg:*)",
      "Bash(git grep:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(cat:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Read(*)"
    ],
    "deny": [
      "Bash(.*\\.ssh/.*:*)",
      "Bash(chgrp:*)",
      "Bash(chown:*)",
      "Bash(curl:*)",
      "Bash(dd:*)",
      "Bash(env:*)",
      "Bash(fdisk:*)",
      "Bash(git add:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git reset:*)",
      "Bash(git tag -d:*)",
      "Bash(kill -9:*)",
      "Bash(mkfs*:*)",
      "Bash(poweroff:*)",
      "Bash(printenv:*)",
      "Bash(reboot:*)",
      "Bash(rm -[rf].*)",
      "Bash(rm -rf:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(shutdown:*)",
      "Bash(ssh:*)",
      "Bash(su:*)",
      "Bash(sudo:*)",
      "Bash(wget:*)",
      "Read(.env*)",
      "Read(.env.*)",
      "Read(id_ed25519)",
      "Read(id_rsa)",
      "Read(~/.ssh/*)",
      "Write(.env*)",
      "Write(~/.ssh/*)"
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'jq -r \".title, .message\" | { read -r title; read -r message; osascript -e \"display notification \\\"$message\\\" with title \\\"$title\\\" sound name \\\"Glass\\\"\"; }'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"作業が完了しました。\" with title \"Claude Code\" sound name \"Glass\"'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.js"
  },
  "alwaysThinkingEnabled": false
}
