{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(fd:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue create:*)",
      "Read(./**)",
      "mcp__awslabs_aws-documentation",
      "mcp__aws-knowledge",
      "Bash(terraform fmt -check:*)",
      "Bash(pnpm biome check:*)",
      "Bash(pnpm -F * biome check:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm -F api-schema build:*)",
      "Bash(pnpm -F @aim-management/api-schema build:*)",
      "Bash(pnpm -F @aim-management/api-schema test:*)",
      "Bash(pnpm -F @aim/api-schema build:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm -F frontend test:*)",
      "Bash(pnpm -F backend test:*)",
      "Bash(pnpm -F api-schema test:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm -F frontend typecheck:*)",
      "Bash(pnpm -F backend typecheck:*)",
      "Bash(pnpm -F frontend run typecheck:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm lint:fix)",
      "Bash(pnpm run lint:*)",
      "Bash(pnpm run build:*)",
      "Bash(pnpm run test:*)",
      "Bash(pnpm run typecheck:*)",
      "Bash(pnpm run validate:*)",
      "Bash(pnpm validate:*)",
      "Bash(pnpm ls:*)",
      "Bash(pnpm view:*)",
      "Bash(pnpm why:*)",
      "Bash(pnpm -r why:*)",
      "Bash(pnpm audit:*)",
      "Bash(pnpm -F backend exec tsc:*)",
      "Bash(pnpm -F frontend exec tsc:*)",
      "Bash(terraform validate:*)",
      "Bash(terraform fmt:*)",
      "Bash(git log:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git ls-files:*)",
      "Bash(git grep:*)",
      "Bash(npm view:*)",
      "Bash(osascript -e:*)",
      "mcp__codex__codex"
    ],
    "deny": [
      "NotebookEdit",
      "Bash(.*\\.ssh/.*:*)",
      "Bash(chgrp:*)",
      "Bash(chown:*)",
      "Bash(curl:*)",
      "Bash(dd:*)",
      "Bash(env:*)",
      "Bash(fdisk:*)",
      "Bash(git checkout:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git tag -d:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(sudo:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(rm -f:*)",
      "Bash(echo \"y\" | rm :*)",
      "Bash(kill -9:*)",
      "Bash(mkfs:*:*)",
      "Bash(poweroff:*)",
      "Bash(printenv:*)",
      "Bash(reboot:*)",
      "Bash(shutdown:*)",
      "Bash(su:*)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(terraform apply*)",
      "Read(terraform destroy*)",
      "Bash(drizzle push:*)",
      "Read(id_ed25519)",
      "Read(id_rsa)",
      "Read(~/.ssh/*)",
      "Read(~/.ssh/**)",
      "Edit(.env*)",
      "Edit(~/.ssh/*)",
      "Edit(~/.ssh/**)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/claude-notify-list.sh record permission"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/take/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/claude-notify-list.sh record stop"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.js",
    "hideVimModeIndicator": true
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "~>''<~",
      "Thinking",
      "Processing",
      "Working"
    ]
  },
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "auto",
  "editorMode": "vim",
  "vimInsertModeRemaps": {
    "jj": "<Esc>"
  },
  "preferredNotifChannel": "terminal_bell",
  "autoCompactEnabled": false,
  "skipAutoPermissionPrompt": true
}
