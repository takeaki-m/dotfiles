{
  "title": "Operation with Space Key",
  "rules": [
    {
      "description": "tmux window move with a and s (terminal apps)",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "a",
            "modifiers": {
              "mandatory": [
                "left_control",
                "left_command"
              ]
            }
          },
          "to": [
            {
              "key_code": "p",
              "modifiers": ["option"]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.googlecode\\.iterm2$",
                "^com\\.mitchellh\\.ghostty$"
              ]
            },
            {
              "type": "device_unless",
              "identifiers": [
                {
                  "vendor_id": 7504,
                  "product_id": 24868,
                  "description": "ultimate hacking keyboard"
                }
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "s",
            "modifiers": {
              "mandatory": [
                "left_control",
                "left_command"
              ]
            }
          },
          "to": [
            {
              "key_code": "n",
              "modifiers": ["option"]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.googlecode\\.iterm2$",
                "^com\\.mitchellh\\.ghostty$"
              ]
            },
            {
              "type": "device_unless",
              "identifiers": [
                {
                  "vendor_id": 7504,
                  "product_id": 24868,
                  "description": "ultimate hacking keyboard"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "browser tab move with a and s",
