{
  "title": "vimの操作を簡単にするためのkarabinerの設定",
  "rules": [
    {
      "description": "Ctrl-s: tmux prefixキー送信前に英数(ASCII)に切り替える",
      "manipulators": [
        {
          "type": "basic",
          "description": "optionalにcommandを含めない: space(=control+command)+sはtmux window移動ルールに譲るため。commandを許容するとこのルールが先勝ちしてプレフィックス送信になり、次window移動が動かなくなる",
          "from": {
            "key_code": "s",
            "modifiers": {
              "mandatory": [ "control" ],
              "optional": [ "caps_lock", "shift", "option", "fn" ]
            }
          },
          "to": [
            { "key_code": "japanese_eisuu" },
            {
              "key_code": "s",
              "modifiers": [ "left_control" ]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.mitchellh\\.ghostty$",
                "^com\\.googlecode\\.iterm2$",
                "^io\\.alacritty$",
                "^com\\.apple\\.Terminal$"
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "Ctrl-g: switch to Eisu (ASCII) and send Ctrl-g",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "g",
            "modifiers": {
              "mandatory": [ "control" ],
              "optional": [ "any" ]
            }
          },
          "to": [
            { "key_code": "japanese_eisuu" },
            {
              "key_code": "g",
              "modifiers": [ "left_control" ]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.mitchellh\\.ghostty$",
                "^com\\.googlecode\\.iterm2$",
                "^io\\.alacritty$",
                "^com\\.apple\\.Terminal$"
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "Ctrl-o: switch to Eisu (ASCII) and send Ctrl-o",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "o",
            "modifiers": {
              "mandatory": [ "control" ],
              "optional": [ "any" ]
            }
          },
          "to": [
            { "key_code": "japanese_eisuu" },
            {
              "key_code": "o",
              "modifiers": [ "left_control" ]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.mitchellh\\.ghostty$",
                "^com\\.googlecode\\.iterm2$",
                "^io\\.alacritty$",
                "^com\\.apple\\.Terminal$"
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "Ctrl-;: switch to Eisu (ASCII) and send Ctrl-;",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "semicolon",
            "modifiers": {
              "mandatory": [ "control" ],
              "optional": [ "any" ]
            }
          },
          "to": [
            { "key_code": "japanese_eisuu" },
            {
              "key_code": "semicolon",
              "modifiers": [ "left_control" ]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.mitchellh\\.ghostty$",
                "^com\\.googlecode\\.iterm2$",
                "^io\\.alacritty$",
                "^com\\.apple\\.Terminal$"
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "Ctrl-/: switch to Eisu (ASCII) and send Ctrl-/",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "slash",
            "modifiers": {
              "mandatory": [ "control" ],
              "optional": [ "any" ]
            }
          },
          "to": [
            { "key_code": "japanese_eisuu" },
            {
              "key_code": "slash",
              "modifiers": [ "left_control" ]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^com\\.mitchellh\\.ghostty$",
                "^com\\.googlecode\\.iterm2$",
                "^io\\.alacritty$",
                "^com\\.apple\\.Terminal$"
              ]
            }
          ]
        }
      ]
    },
    {
      "description": "For vim insert mode, Home and End key",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "s",
            "modifiers": {
              "mandatory": ["left_control", "left_command"],
              "optional": ["any"]
            }
          },
          "to": [
            {
              "key_code": "end",
              "modifiers": ["any"]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_unless",
              "bundle_identifiers": [
                "^com\\.apple\\.Terminal$",
                "^com\\.mitchellh\\.ghostty$",
                "^com\\.googlecode\\.iterm2$"
              ]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "a",
            "modifiers": {
              "mandatory": ["left_control", "left_command"],
              "optional": ["any"]
            }
          },
          "to": [
            {
              "key_code": "home",
              "modifiers": ["any"]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_unless",
              "bundle_identifiers": [
                "^com\\.apple\\.Terminal$",
                "^com\\.mitchellh\\.ghostty$",
                "^com\\.googlecode\\.iterm2$"
              ]
            }
          ]
        }
      ]
    }
  ]
}
