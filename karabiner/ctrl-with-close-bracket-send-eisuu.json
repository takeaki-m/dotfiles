{
  "title": "Esc with close_bracket send japanese_eisuu",
  "rules": [
    {
      "description": "Ctrl-] sends Eisu + Ctrl-]",
      "manipulators": [
        {
          "type": "basic",
          "conditions": [
            {
              "input_sources": [
                { "language": "ja" }
              ],
              "type": "input_source_if"
            }
          ],
          "from": {
            "key_code": "close_bracket",
            "modifiers": {
              "mandatory": ["left_control"],
              "optional": ["any"]
            }
          },
          "to": [
            { "key_code": "japanese_eisuu" },
            {
              "key_code": "close_bracket",
              "modifiers": ["left_control"]
            }
          ]
        }
      ]
    }
  ]
}
