{
  "title": "Move Cursor Home and End",
  "rules": [
    {
      "description": "For vim insert mode, Home and End key",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "s",
            "modifiers": {
              "mandatory": ["left_control", "left_command"],
              "optional": ["any"]
            }
          },
          "to": [
            {
              "key_code": "end",
              "modifiers": ["any"]
            }
          ]
        },
        {
          "type": "basic",
          "from": {
            "key_code": "a",
            "modifiers": {
              "mandatory": ["left_control", "left_command"],
              "optional": ["any"]
            }
          },
          "to": [
            {
              "key_code": "home",
              "modifiers": ["any"]
            }
          ]
        }
      ]
    }
  ]
}
