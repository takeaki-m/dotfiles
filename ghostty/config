font-size = 16
#theme = dark:Catppuccin Frappe,light:Flexoki Light
theme = dark:IR Black,light:Nvim Light
#theme = dark:IR Black,light:Vimbones
#theme = Hybrid
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
window-decoration = none
window-show-tab-bar = never
macos-titlebar-style = hidden
font-family = JetBrainsMono Nerd Font
#font-family = Hack Nerd Font Mono
#font-family = Menlo
#font-family  = FiraCode Nerd Font Ret
#font-family = "Hiragino Kaku Gothic ProN"
font-thicken = true
# macOSのOptionキーをAlt(Meta)キーとして動作させる
# Nvim/Vimの<M-x>キーバインドを有効にするために必要
macos-option-as-alt = true
desktop-notifications = true
